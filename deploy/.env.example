# Wird von setup.sh nach .env kopiert. Domain und Impressum danach selbst eintragen.
DOMAIN=meine-mensa.duckdns.org

# Impressum (Pflichtangaben, erscheinen öffentlich auf der Seite)
IMPRESS_FULLNAME=Vorname Nachname
IMPRESS_STRASSE_HAUSNR=Musterstraße 1
IMPRESS_PLZ_ORT=04109 Leipzig
IMPRESS_TELEFON=+49 000 0000000
IMPRESS_EMAIL=name@example.org

# Werden von setup.sh zufällig erzeugt. Nicht ändern, sonst sind alle Sitzungen ungültig.
JWT_SECRET=
AES_KEY=
